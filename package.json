{
	"name": "slimpals",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "concurrently -n vite,server -c cyan,green \"vite\" \"tsx --env-file=.env watch server/index.ts\"",
		"build": "vite build",
		"build:server": "tsc -p tsconfig.server.json",
		"preview": "vite preview",
		"check": "biome check .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@google/generative-ai": "^0.24.1",
		"better-auth": "^1.6.14",
		"cors": "^2.8.5",
		"drizzle-orm": "^0.45.2",
		"express": "^5.2.1",
		"mysql2": "^3.22.5",
		"page": "^1.11.6",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^22.14.1",
		"@types/page": "^1.11.9",
		"@types/supertest": "^7.2.0",
		"concurrently": "^10.0.3",
		"d3": "^7.9.0",
		"drizzle-kit": "^0.31.10",
		"supertest": "^7.2.2",
		"svelte": "^5.56.3",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.22.4",
		"typescript": "^5.8.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	}
}
