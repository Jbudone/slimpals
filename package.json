{
	"name": "slimpals",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "concurrently -n vite,server -c cyan,green \"vite\" \"tsx watch --env-file=.env server/index.ts\"",
		"build": "vite build --outDir dist/client && tsc -p tsconfig.server.json",
		"start": "NODE_ENV=production node dist/server/server/index.js",
		"preview": "vite preview",
		"check": "biome check .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"test": "vitest run",
		"test:watch": "vitest",
		"seed": "tsx --env-file=.env scripts/seed-dev.ts",
		"generate-gym-assets": "tsx --env-file=.env scripts/generate-gym-assets.ts",
		"generate-assets": "tsx --env-file=.env scripts/generate-assets.ts"
	},
	"dependencies": {
		"@google/generative-ai": "^0.24.1",
		"better-auth": "^1.6.14",
		"cors": "^2.8.5",
		"drizzle-orm": "^0.45.2",
		"express": "^5.2.1",
		"fast-xml-parser": "^5.9.3",
		"multer": "^2.2.0",
		"mysql2": "^3.22.5",
		"page": "^1.11.6",
		"phaser": "^3.90.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/multer": "^2.1.0",
		"@types/node": "^22.14.1",
		"@types/page": "^1.11.9",
		"@types/sharp": "^0.31.1",
		"@types/supertest": "^7.2.0",
		"concurrently": "^10.0.3",
		"d3": "^7.9.0",
		"drizzle-kit": "^0.31.10",
		"playwright": "^1.61.0",
		"sharp": "^0.35.3",
		"supertest": "^7.2.2",
		"svelte": "^5.56.3",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.22.4",
		"typescript": "^5.8.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	}
}
