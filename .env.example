# Database
# Local dev convention: MySQL/MariaDB in a `slimpals-test-db` Docker container,
# host port 3307 -> container 3306 (see docs/gh4-auth.md). Only used directly
# when NOT going through `docker-compose up` (see MYSQL_* below for that case).
DATABASE_URL=mysql://slimpals:slimpalspass@127.0.0.1:3307/slimpals

# MySQL (for Docker Compose — a separate all-in-one stack, port 3306 inside
# the compose network; docker-compose.yml reads these to configure the mysql
# service container)
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=slimpals
MYSQL_USER=slimpals
MYSQL_PASSWORD=slimpals

# Auth
BETTER_AUTH_SECRET=change-this-to-a-random-32-char-string
BETTER_AUTH_URL=http://localhost:3000
# Vite dev server origin, added to Better Auth's trusted origins
FRONTEND_URL=http://localhost:5173

# AI
GEMINI_API_KEY=your-gemini-api-key-here

# Cron: shared secret required in the X-Cron-Secret header to call
# POST /api/gym/cron/generate-content. Leave unset to keep that route disabled.
# CRON_SECRET=

# Storage
STORAGE_PROVIDER=local
# BUNNYCDN_API_KEY=
# BUNNYCDN_STORAGE_ZONE=
# BUNNYCDN_CDN_URL=

# App
PORT=3000
NODE_ENV=development

# Dev-only: skip the login screen and auto-authenticate every request as this
# user. Never applies when NODE_ENV=production. Point it at the admin account
# created by `npm run seed` to autologin as admin.
# DEV_AUTOLOGIN_EMAIL=dev@slimpals.test
