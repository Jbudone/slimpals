node_modules/
dist/
.env
uploads/
*.md
# Prompt tuning docs are read from disk at runtime (see
# server/services/contentTuning/fs.ts) — must survive the *.md exclusion
# above so the builder stage's `COPY . .` actually includes them.
!server/services/ai/prompts/*.md
!server/services/contentTuning/docs/*.md
