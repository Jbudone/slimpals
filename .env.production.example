# ── Domain ────────────────────────────────────────────────────────────────────
DOMAIN=slimpals.example.com

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=slimpals
MYSQL_USER=slimpals
MYSQL_PASSWORD=change-me-db

# ── Auth ──────────────────────────────────────────────────────────────────────
BETTER_AUTH_URL=https://slimpals.example.com
BETTER_AUTH_SECRET=generate-a-random-secret-at-least-32-chars

# ── AI ────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ── Storage ───────────────────────────────────────────────────────────────────
# "local" stores uploads on disk; "bunnycdn" uploads to BunnyCDN
STORAGE_PROVIDER=local

# Required only when STORAGE_PROVIDER=bunnycdn
BUNNYCDN_API_KEY=
BUNNYCDN_STORAGE_ZONE=
BUNNYCDN_CDN_URL=https://your-zone.b-cdn.net

# ── Scheduled jobs ────────────────────────────────────────────────────────────
# The in-process scheduler is on by default in production (SCHEDULER_ENABLED=0
# turns it off). CRON_SECRET is optional: only needed to call the generation
# endpoints by hand with an X-Cron-Secret header; unset keeps them closed.
# SCHEDULER_ENABLED=
# CRON_SECRET=

# ── App ───────────────────────────────────────────────────────────────────────
CORS_ORIGIN=https://slimpals.example.com
NODE_ENV=production
PORT=3000
